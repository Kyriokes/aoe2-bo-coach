<Project>
  <!-- Configuración común a todos los proyectos de la solución -->
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Un aviso de seguridad nuevo de NuGet no rompe el CI sin que nadie haya tocado código: queda como aviso y lo levanta Dependabot -->
    <WarningsNotAsErrors>NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>
</Project>
