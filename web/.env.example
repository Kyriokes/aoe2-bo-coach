# Copiá este archivo como .env.local y completalo con los datos de tu proyecto de Supabase
# (Project Settings → API). Son públicos: los permisos los ponen las políticas por fila de la base.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# Dirección pública del sitio (para los enlaces de "Abrir en BO Coach" y el regreso del login).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
