# Copiá este archivo como .env.local y completalo con los datos de tu proyecto de Supabase
# (Project Settings → API Keys). Son públicos: los permisos los ponen las políticas por fila de la base.
# Nunca pongas acá la clave secreta (secret / service_role): la web no la necesita.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Opcional: la dirección pública de la web (dominio propio). Sin esto se usa la de producción de Vercel, o localhost.
# NEXT_PUBLIC_SITE_URL=https://aoe2-bo-coach.vercel.app
