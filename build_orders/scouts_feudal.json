{
  "schema_version": 1,
  "id": "ejemplo-scouts",
  "name": "Scouts Feudal (22 pop)",
  "civ": "any",
  "author": "BO Coach (ejemplo)",
  "description": "Exploradores en Feudal para Arabia. 21 aldeanos y el explorador inicial; Feudal a 22 de población.",
  "tags": ["feudal", "scouts", "arabia"],
  "steps": [
    { "id": "s1", "do": "build", "what": "house", "count": 2, "assign": "sheep", "confirm_by": "house_built", "note": "Los 3 aldeanos iniciales hacen 2 casas y van a las ovejas" },
    { "id": "s2", "do": "train", "what": "villager", "count": 6, "assign": "sheep" },
    { "id": "s3", "do": "train", "what": "villager", "count": 4, "assign": "wood" },
    { "id": "s4", "do": "build", "what": "lumber_camp", "from": "wood", "assign": "wood", "confirm_by": "lumber_camp_built", "note": "Lo hace el primer aldeano de madera" },
    { "id": "s5", "do": "build", "what": "house", "from": "wood", "assign": "wood", "confirm_by": "house_built" },
    { "id": "s6", "do": "train", "what": "villager", "count": 1, "assign": "hunt", "note": "Atraé el jabalí al centro urbano" },
    { "id": "s7", "do": "train", "what": "villager", "count": 3, "assign": "berries" },
    { "id": "s8", "do": "build", "what": "mill", "from": "berries", "assign": "berries", "confirm_by": "mill_built" },
    { "id": "s9", "do": "train", "what": "villager", "count": 2, "assign": "hunt", "note": "Segundo jabalí" },
    { "id": "s10", "do": "build", "what": "house", "from": "wood", "assign": "wood", "confirm_by": "house_built" },
    { "id": "s11", "do": "train", "what": "villager", "count": 2, "assign": "wood" },
    { "id": "s12", "do": "research", "what": "loom" },
    { "id": "s13", "do": "research", "what": "feudal_age", "at_pop": 22, "note": "Mientras sube: cuartel y una casa" },
    { "id": "s14", "do": "build", "what": "barracks", "from": "wood", "assign": "wood", "confirm_by": "barracks_built" },
    { "id": "s15", "do": "build", "what": "stable", "from": "wood", "assign": "wood", "after": ["s13"], "confirm_by": "stable_built" },
    { "id": "s16", "do": "build", "what": "farm", "count": 3, "from": "sheep", "assign": "farm", "note": "Cuando se terminan las ovejas" },
    { "id": "s17", "do": "train", "what": "scout_cavalry", "count": 3 }
  ],
  "targets": {
    "feudal_click_time": 540,
    "villagers_at_feudal": { "food": 15, "wood": 6, "gold": 0, "stone": 0 }
  }
}
