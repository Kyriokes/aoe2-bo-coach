{
  "schema_version": 1,
  "id": "ejemplo-fast-castle",
  "name": "Fast Castle (27 + 2)",
  "civ": "any",
  "author": "BO Coach (ejemplo)",
  "description": "Castillos rápido: Feudal a 27 de población, herrería y mercado, y Castillos con 2 aldeanos más en oro.",
  "tags": ["castle", "fast-castle", "boom"],
  "steps": [
    { "id": "s1", "do": "build", "what": "house", "count": 2, "builders": 3, "assign": "sheep", "confirm_by": "house_built", "note": "Los 3 aldeanos iniciales hacen 2 casas y van a las ovejas" },
    { "id": "s2", "do": "train", "what": "villager", "count": 6, "assign": "sheep" },
    { "id": "s3", "do": "train", "what": "villager", "count": 3, "assign": "wood" },
    { "id": "s4", "do": "build", "what": "lumber_camp", "from": "wood", "assign": "wood", "confirm_by": "lumber_camp_built" },
    { "id": "s5", "do": "build", "what": "house", "from": "wood", "assign": "wood", "confirm_by": "house_built" },
    { "id": "s6", "do": "train", "what": "villager", "count": 1, "assign": "hunt", "note": "Atraé el jabalí al centro urbano" },
    { "id": "s7", "do": "train", "what": "villager", "count": 4, "assign": "berries" },
    { "id": "s8", "do": "build", "what": "mill", "from": "berries", "assign": "berries", "confirm_by": "mill_built" },
    { "id": "s9", "do": "train", "what": "villager", "count": 1, "assign": "hunt", "note": "Segundo jabalí" },
    { "id": "s10", "do": "build", "what": "house", "from": "wood", "assign": "wood", "confirm_by": "house_built" },
    { "id": "s11", "do": "train", "what": "villager", "count": 5, "assign": "wood" },
    { "id": "s12", "do": "build", "what": "house", "from": "wood", "assign": "wood", "confirm_by": "house_built" },
    { "id": "s13", "do": "train", "what": "villager", "count": 3, "assign": "gold" },
    { "id": "s14", "do": "build", "what": "mining_camp", "from": "gold", "assign": "gold", "confirm_by": "mining_camp_built" },
    { "id": "s15", "do": "research", "what": "loom" },
    { "id": "s16", "do": "research", "what": "feudal_age", "at_pop": 27, "note": "Mientras sube: granjas con los de ovejas" },
    { "id": "s17", "do": "build", "what": "farm", "count": 5, "from": "sheep", "assign": "farm" },
    { "id": "s18", "do": "build", "what": "blacksmith", "from": "wood", "assign": "wood", "after": ["s16"], "confirm_by": "blacksmith_built" },
    { "id": "s19", "do": "build", "what": "market", "from": "wood", "assign": "wood", "after": ["s16"], "confirm_by": "market_built" },
    { "id": "s20", "do": "train", "what": "villager", "count": 2, "assign": "gold" },
    { "id": "s21", "do": "research", "what": "castle_age", "at_pop": 29 }
  ],
  "targets": {
    "feudal_click_time": 660,
    "castle_click_time": 990,
    "villagers_at_feudal": { "food": 15, "wood": 8, "gold": 3, "stone": 0 },
    "villagers_at_castle": { "food": 15, "wood": 8, "gold": 5, "stone": 0 }
  }
}
