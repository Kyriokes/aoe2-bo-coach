<Window x:Class="BoCoach.App.Web.WebAccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:BoCoach.App"
        Title="{x:Static app:Texts.WebAccountTitle}" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Style="{StaticResource AppWindow}">
    <StackPanel Margin="18">
        <TextBlock Text="{x:Static app:Texts.WebAccountIntro}" Style="{StaticResource Body}" Margin="0,0,0,14" />

        <TextBlock Text="{x:Static app:Texts.WebAddress}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
        <TextBox x:Name="UrlBox" Margin="0,0,0,12" />

        <TextBlock Text="{x:Static app:Texts.WebToken}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
        <PasswordBox x:Name="TokenBox" Margin="0,0,0,4" />
        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,14">
            <Run Text="{x:Static app:Texts.WebTokenBefore}" /><Hyperlink Click="OpenAccountPage"><Run Text="{x:Static app:Texts.WebTokenLink}" /></Hyperlink><Run Text="{x:Static app:Texts.WebTokenAfter}" />
        </TextBlock>

        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="{x:Static app:Texts.WebLinksHint}" Style="{StaticResource Body}" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button x:Name="RegisterButton" Content="{x:Static app:Texts.WebLinksRegister}" Click="RegisterLinks" />
                    <TextBlock x:Name="LinkStatus" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{StaticResource Muted}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{x:Static app:Texts.WebSave}" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="Save" />
            <Button Content="{x:Static app:Texts.Cancel}" IsCancel="True" Margin="0" />
        </StackPanel>
    </StackPanel>
</Window>
