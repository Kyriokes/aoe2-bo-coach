<Window x:Class="BoCoach.App.Web.WebAccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cuenta de la web" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource Background}"
        FontFamily="Segoe UI" FontSize="13">
    <StackPanel Margin="18">
        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,12">
            Con la cuenta de la biblioteca web podés publicar tus BO desde el editor. Para importar BO de otros no hace falta.
        </TextBlock>

        <TextBlock Text="Dirección de la web" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="UrlBox" Margin="0,0,0,12" />

        <TextBlock Text="Token de la app" Style="{StaticResource FieldLabel}" />
        <PasswordBox x:Name="TokenBox" Margin="0,0,0,4" />
        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,12">
            Se crea en <Hyperlink Click="OpenAccountPage">Mi cuenta de la web</Hyperlink>. Se guarda cifrado para tu usuario de Windows.
        </TextBlock>

        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="10" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock TextWrapping="Wrap">
                    Enlaces «Abrir en BO Coach»: para que el botón de la web abra la BO directo en esta app, Windows tiene que saber que los enlaces bocoach:// son de BO Coach.
                </TextBlock>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button x:Name="RegisterButton" Content="Registrar enlaces bocoach://" Click="RegisterLinks" />
                    <TextBlock x:Name="LinkStatus" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{StaticResource Muted}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Guardar" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="Save" />
            <Button Content="Cancelar" IsCancel="True" Margin="0" />
        </StackPanel>
    </StackPanel>
</Window>
