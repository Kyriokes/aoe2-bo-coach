<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>BoCoach</AssemblyName>
    <Product>AoE2 BO Coach</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.9.53</Version>
  </PropertyGroup>

  <!-- Cuándo se compiló, para mostrarlo junto a la versión y el commit (AppVersion) -->
  <ItemGroup>
    <AssemblyMetadata Include="BuildTime" Value="$([System.DateTime]::Now.ToString('yyyy-MM-dd HH:mm'))" />
  </ItemGroup>

  <!--
    Versión portable: dotnet publish src/BoCoach.App -c Release -r win-x64
    Un solo BoCoach.exe con el runtime de .NET adentro (no hay que instalar nada) y la carpeta data al lado.
  -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Sin compresión: comprimido, .NET descomprime los ensamblados en memoria y la RAM privada sube unos 60 MB.
         El .zip de la descarga ya comprime. -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <!-- Tampoco los .pdb de Core y Vision -->
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BoCoach.Core\BoCoach.Core.csproj" />
    <ProjectReference Include="..\BoCoach.Vision\BoCoach.Vision.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <!-- Datos del juego, eventos y BO de ejemplo, copiados junto al ejecutable -->
  <ItemGroup>
    <None Include="..\..\data\game_data\*.json" Link="data\game_data\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Include="..\..\data\events*.json" Link="data\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Include="..\..\data\civ_styles.json" Link="data\civ_styles.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Include="..\..\data\maps.json" Link="data\maps.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Include="..\..\data\matchup_stats.json" Link="data\matchup_stats.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Include="..\..\data\hud_layout.json" Link="data\hud_layout.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Include="..\..\data\fonts\*.json" Link="data\fonts\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Include="..\..\data\icons\*.json" Link="data\icons\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <!-- Instrucciones de la versión portable -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' != ''">
    <None Include="..\..\docs\LEEME-portable.txt" Link="LEEME.txt" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

</Project>
