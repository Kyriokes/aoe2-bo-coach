<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>BoCoach</AssemblyName>
    <Product>AoE2 BO Coach</Product>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BoCoach.Core\BoCoach.Core.csproj" />
    <ProjectReference Include="..\BoCoach.Vision\BoCoach.Vision.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <!-- Datos del juego, eventos y BO de ejemplo, copiados junto al ejecutable -->
  <ItemGroup>
    <None Include="..\..\data\game_data\*.json" Link="data\game_data\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\data\events.json" Link="data\events.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\build_orders\*.json" Link="data\build_orders\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
