<Application x:Class="BoCoach.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:BoCoach.App"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Dark.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters -->
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <local:StarConverter x:Key="Star" />
            <local:NotEmptyToVisibilityConverter x:Key="NotEmptyToVisibility" />
            <local:NullToVisibilityConverter x:Key="NullToVisibility" />
            <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />

            <!-- Un recurso en el panel "Lo que ve el coach": lo leído del HUD y los aldeanos que le tocan según la BO -->
            <DataTemplate x:Key="LiveResourceTemplate">
                <StackPanel Margin="0,0,24,0" MinWidth="90">
                    <TextBlock Text="{Binding Label}" Foreground="#A39A8F" FontSize="11" />
                    <TextBlock Text="{Binding Stock}" Foreground="#F4F2EE" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Villagers}" Foreground="#E8C26A" FontSize="12" />
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
