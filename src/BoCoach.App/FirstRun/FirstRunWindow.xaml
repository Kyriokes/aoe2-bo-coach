<Window x:Class="BoCoach.App.FirstRun.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:firstRun="clr-namespace:BoCoach.App.FirstRun"
        xmlns:app="clr-namespace:BoCoach.App"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance firstRun:FirstRunViewModel}"
        Title="{x:Static app:Texts.FirstRunTitle}" Width="640" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Style="{StaticResource AppWindow}">
    <Window.Resources>
        <!-- El número de cada paso -->
        <Style x:Key="Badge" TargetType="Border">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="CornerRadius" Value="13" />
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
        <Style x:Key="BadgeNumber" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentInk}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="StepBox" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,0,0,18" />
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <TextBlock Text="{x:Static app:Texts.FirstRunTitle}" Style="{StaticResource AppTitle}" Margin="0,0,0,4" />
            <TextBlock Text="{x:Static app:Texts.FirstRunIntro}" Style="{StaticResource Body}" Margin="0,0,0,18" />

            <!-- 1. Cuenta de la web -->
            <DockPanel Style="{StaticResource StepBox}">
                <Border Style="{StaticResource Badge}"><TextBlock Text="1" Style="{StaticResource BadgeNumber}" /></Border>
                <StackPanel>
                    <TextBlock Text="{x:Static app:Texts.FirstRunAccountTitle}" Style="{StaticResource StepTitle}" />
                    <TextBlock Text="{x:Static app:Texts.FirstRunAccountBody}" Style="{StaticResource Body}" Margin="0,3,0,8" />
                    <StackPanel x:Name="AccountBox" Orientation="Horizontal">
                        <Button Content="{x:Static app:Texts.ConnectAccount}" Command="{Binding ConnectCommand}" />
                        <TextBlock Text="{Binding AccountText}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>

            <!-- 2. Idioma -->
            <DockPanel Style="{StaticResource StepBox}">
                <Border Style="{StaticResource Badge}"><TextBlock Text="2" Style="{StaticResource BadgeNumber}" /></Border>
                <StackPanel>
                    <TextBlock Text="{x:Static app:Texts.FirstRunLanguageTitle}" Style="{StaticResource StepTitle}" />
                    <StackPanel x:Name="LanguageBox" Orientation="Horizontal" Margin="0,6,0,0">
                        <ComboBox ItemsSource="{Binding LanguageOptions}" SelectedItem="{Binding Language}" Width="220"
                                  AutomationProperties.Name="{x:Static app:Texts.GameLanguageLabel}" />
                        <TextBlock Text="{x:Static app:Texts.FirstRunLanguageBody}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>

            <!-- 3. Mod -->
            <DockPanel Style="{StaticResource StepBox}">
                <Border Style="{StaticResource Badge}"><TextBlock Text="3" Style="{StaticResource BadgeNumber}" /></Border>
                <StackPanel>
                    <TextBlock Text="{x:Static app:Texts.FirstRunModTitle}" Style="{StaticResource StepTitle}" />
                    <TextBlock Text="{x:Static app:Texts.FirstRunModBody}" Style="{StaticResource Body}" Margin="0,3,0,8" />
                    <Button x:Name="InstallModButton" Content="{x:Static app:Texts.InstallMod}" HorizontalAlignment="Left" />
                </StackPanel>
            </DockPanel>

            <!-- 4. Partida contra la IA -->
            <DockPanel Style="{StaticResource StepBox}">
                <Border Style="{StaticResource Badge}"><TextBlock Text="4" Style="{StaticResource BadgeNumber}" /></Border>
                <StackPanel>
                    <TextBlock Text="{x:Static app:Texts.FirstRunMatchTitle}" Style="{StaticResource StepTitle}" />
                    <TextBlock Text="{x:Static app:Texts.FirstRunMatchBody}" Style="{StaticResource Body}" Margin="0,3,0,8" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{Binding WatchButtonText}" Command="{Binding ToggleWatchingCommand}" />
                        <TextBlock Text="{Binding CalibrationStatus}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="{Binding WatchStatus}" Style="{StaticResource Body}" Margin="0,6,0,0"
                               Visibility="{Binding WatchStatus, Converter={StaticResource NotEmptyToVisibility}}" />
                </StackPanel>
            </DockPanel>

            <!-- 5. Nombre -->
            <DockPanel Style="{StaticResource StepBox}">
                <Border Style="{StaticResource Badge}"><TextBlock Text="5" Style="{StaticResource BadgeNumber}" /></Border>
                <StackPanel>
                    <TextBlock Text="{x:Static app:Texts.FirstRunNameTitle}" Style="{StaticResource StepTitle}" />
                    <TextBlock Text="{x:Static app:Texts.FirstRunNameBody}" Style="{StaticResource Body}" Margin="0,3,0,8" />
                    <ListBox ItemsSource="{Binding Players}" SelectedItem="{Binding SelectedPlayer}" MaxHeight="190" Margin="0,0,0,8"
                             Visibility="{Binding HasPlayers, Converter={StaticResource BoolToVisibility}}"
                             AutomationProperties.Name="{x:Static app:Texts.FirstRunPlayersName}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock><Run Text="{Binding Slot, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="   " /><Run Text="{Binding Name, Mode=OneWay}" /><Run Text="   " /><Run Text="{Binding CivText, Mode=OneWay}" Foreground="{StaticResource Muted}" /></TextBlock>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBox Text="{Binding PlayerName, UpdateSourceTrigger=PropertyChanged}" Width="240" HorizontalAlignment="Left"
                             AutomationProperties.Name="{x:Static app:Texts.PlayerNameLabel}" />
                </StackPanel>
            </DockPanel>

            <!-- 6. Compartir las partidas (spec 2026-11-02-registro-de-partida) -->
            <DockPanel Style="{StaticResource StepBox}">
                <Border Style="{StaticResource Badge}"><TextBlock Text="6" Style="{StaticResource BadgeNumber}" /></Border>
                <StackPanel>
                    <TextBlock Text="{x:Static app:Texts.FirstRunShareTitle}" Style="{StaticResource StepTitle}" />
                    <TextBlock Text="{x:Static app:Texts.ShareExplanation}" Style="{StaticResource Body}" Margin="0,3,0,8" />
                    <CheckBox x:Name="ShareBox" IsChecked="{Binding ShareGames}" Content="{x:Static app:Texts.ShareGamesLabel}" />
                </StackPanel>
            </DockPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{x:Static app:Texts.FirstRunFinish}" IsDefault="True" Style="{StaticResource PrimaryButton}" Command="{Binding FinishCommand}" />
                <Button Content="{x:Static app:Texts.Close}" IsCancel="True" Margin="0" Click="Close_Click" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
