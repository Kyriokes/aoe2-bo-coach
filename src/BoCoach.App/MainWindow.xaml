<Window x:Class="BoCoach.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hotkeys="clr-namespace:BoCoach.App.Hotkeys"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:coaching="clr-namespace:BoCoach.App.Coaching"
        xmlns:app="clr-namespace:BoCoach.App"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance coaching:BuildOrdersViewModel}"
        Title="{x:Static app:AppVersion.WindowTitle}"
        Width="1280" Height="820" MinWidth="1000" MinHeight="560"
        FontFamily="Segoe UI" FontSize="13"
        Background="{StaticResource Background}" Foreground="{StaticResource Text}">

    <DockPanel>
        <!-- Barra de estado -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="12,5">
            <DockPanel>
                <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <!-- Herramientas de captura: calibrar la pantalla y grabar partidas -->
        <Border x:Name="ToolsBar" DockPanel.Dock="Top" Background="#2B2622" Padding="12,7">
            <StackPanel>
                <DockPanel>
                    <TextBlock Text="AoE2 BO Coach" Foreground="#F4F2EE" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="{x:Static app:AppVersion.Text}" Foreground="#A39A8F" FontSize="11" VerticalAlignment="Center" Margin="0,0,18,0"
                               MouseLeftButtonUp="Version_Click"
                               ToolTip="Versión · commit · cuándo se compiló" />

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="CoachButton" Content="{Binding ButtonText}" Command="{Binding StartStopCommand}" FontWeight="SemiBold"
                                ToolTip="{Binding StartStop, Source={x:Static hotkeys:HotkeyTips.Instance}}" />
                        <Button Content="Atajos" Click="Hotkeys_Click" ToolTip="Ver y cambiar los atajos de teclado que andan desde el juego" />
                        <Button Content="Primeros pasos" Click="FirstRun_Click"
                                ToolTip="Idioma del juego, mod del HUD, una partida rápida contra 7 IA para calibrar y leer tu nombre en la pantalla de carga" />
                        <Button Content="Calibrar pantalla…" Command="{Binding CalibrateCommand}" Visibility="{Binding IsOn, Source={x:Static app:DevMode.Instance}, Converter={StaticResource BoolToVisibility}}" ToolTip="{Binding Calibrate, Source={x:Static hotkeys:HotkeyTips.Instance}}" />
                        <Button Content="Instalar mod del HUD" Command="{Binding InstallModCommand}"
                                ToolTip="Agrega al juego el mod local &quot;BoCoach HUD&quot;: los aldeanos de cada recurso en cuadrados negros y el reloj más grande, que el coach lee mucho mejor. Se puede volver a tocar sin problema" />
                        <Button Content="{Binding RecordButtonText}" Command="{Binding ToggleRecordingCommand}" Visibility="{Binding RecordButtonVisible, Converter={StaticResource BoolToVisibility}}" ToolTip="{Binding Record, Source={x:Static hotkeys:HotkeyTips.Instance}}" />
                        <Button Content="Grabaciones" Command="{Binding OpenRecordingsCommand}" Visibility="{Binding IsOn, Source={x:Static app:DevMode.Instance}, Converter={StaticResource BoolToVisibility}}" />
                        <Button Content="Apoyar ☕" Click="Support_Click" Margin="0"
                                ToolTip="Invitame un café (Cafecito, PayPal, Ko-fi o Mercado Pago) y mirá las metas del proyecto en la web" />
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Foreground="#C9C1B6" FontSize="12" TextTrimming="CharacterEllipsis"><Run Text="{Binding CalibrationStatus, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding GameStatus, Mode=OneWay}" /></TextBlock>
                        <TextBlock Text="{Binding RecordingStatus}" FontSize="12" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding RecordingStatus, Converter={StaticResource NotEmptyToVisibility}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#8CD17D" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                            <Setter Property="Foreground" Value="#F08070" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </DockPanel>
                <!-- Ajustes de la partida: se aplican al empezar el coach (pasan al renglón de abajo si no entran) -->
                <WrapPanel Margin="0,6,0,0">
                    <StackPanel x:Name="PlayerNameBox" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0"
                                ToolTip="Tu nombre en el juego, como sale en la lista de jugadores de la pantalla de carga. Ahí el coach lee con qué civ jugás (manda sobre la de acá al lado en esa partida), y contra quién, y empieza la partida de cero">
                        <TextBlock Text="Tu nombre" Foreground="#A39A8F" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding PlayerName, UpdateSourceTrigger=LostFocus}" Width="120" VerticalContentAlignment="Center"
                                 AutomationProperties.Name="Tu nombre en el juego" />
                    </StackPanel>
                    <StackPanel x:Name="EloBox" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0"
                                ToolTip="Tu Elo de mapa aleatorio, para las estadísticas reales de cruces de la pantalla de carga y la BO sugerida. Buscar trae el de &quot;Tu nombre&quot; de la API del juego: el nombre se manda solo al tocar el botón">
                        <TextBlock Text="Elo 1v1" Foreground="#A39A8F" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding Elo1v1Text, UpdateSourceTrigger=LostFocus}" Width="50" VerticalContentAlignment="Center"
                                 AutomationProperties.Name="Elo 1v1" />
                        <TextBlock Text="Elo equipos" Foreground="#A39A8F" VerticalAlignment="Center" Margin="8,0,6,0" />
                        <TextBox Text="{Binding EloTeamText, UpdateSourceTrigger=LostFocus}" Width="50" VerticalContentAlignment="Center"
                                 AutomationProperties.Name="Elo de equipos" />
                        <Button Content="Buscar" Command="{Binding SearchEloCommand}" Padding="8,1" Margin="6,0,0,0"
                                AutomationProperties.Name="Buscar mi Elo en la API del juego" />
                        <TextBlock Text="{Binding EloStatus}" Foreground="#C9C1B6" FontSize="12" VerticalAlignment="Center" Margin="6,0,0,0"
                                   Width="240" TextTrimming="CharacterEllipsis" ToolTip="{Binding EloStatus}" />
                    </StackPanel>
                    <StackPanel x:Name="GameCivBox" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0"
                                ToolTip="Con qué civ jugás esta partida: el coach usa sus bonificaciones (costos, población de las casas, recursos iniciales). Por defecto, la civ que dice la BO. Se aplica al empezar el coach">
                        <TextBlock Text="Civ" Foreground="#A39A8F" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox ItemsSource="{Binding CivOptions}" SelectedItem="{Binding GameCiv}" Width="104" VerticalContentAlignment="Center"
                                  AutomationProperties.Name="Civ de esta partida" />
                    </StackPanel>
                    <StackPanel x:Name="GameLanguageBox" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0"
                                ToolTip="En qué idioma está el juego: el log de eventos y la edad se leen con sus frases. Castellano de España y de Latinoamérica difieren en muchos nombres (en el juego: Opciones → Idioma). Se aplica al empezar el coach">
                        <TextBlock Text="Idioma del juego" Foreground="#A39A8F" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox ItemsSource="{Binding LanguageOptions}" SelectedItem="{Binding Language}" Width="170" VerticalContentAlignment="Center"
                                  AutomationProperties.Name="Idioma del juego" />
                    </StackPanel>
                    <StackPanel x:Name="MaxVillagersBox" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0"
                                ToolTip="Hasta cuántos aldeanos producen sin parar los centros urbanos (100 a 130 según la estrategia). La comida nunca baja de lo que necesitan. Se aplica al empezar el coach">
                        <TextBlock Text="Máx. aldeanos" Foreground="#A39A8F" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding MaxVillagers, UpdateSourceTrigger=LostFocus}" Width="44" VerticalContentAlignment="Center"
                                 AutomationProperties.Name="Máximo de aldeanos" />
                    </StackPanel>
                    <CheckBox x:Name="CursorRemindersBox" IsChecked="{Binding CursorReminders}" VerticalAlignment="Center" Margin="0,0,10,0"
                              ToolTip="{Binding CursorReminders, Source={x:Static hotkeys:HotkeyTips.Instance}}">
                        <TextBlock Text="Recordatorios en el mouse" Foreground="#C9C1B6" />
                    </CheckBox>
                    <CheckBox x:Name="AutoStartBox" IsChecked="{Binding AutoStart}" VerticalAlignment="Center" Margin="0,0,10,0"
                              ToolTip="{Binding AutoStart, Source={x:Static hotkeys:HotkeyTips.Instance}}">
                        <TextBlock Text="Coach automático" Foreground="#C9C1B6" />
                    </CheckBox>
                    <CheckBox IsChecked="{Binding AutoRecord, Source={x:Static app:DevMode.Instance}}" VerticalAlignment="Center" Margin="0,0,10,0" Visibility="{Binding IsOn, Source={x:Static app:DevMode.Instance}, Converter={StaticResource BoolToVisibility}}"
                              ToolTip="Modo desarrollador: arranca a grabar cuando empieza una partida y corta cuando termina (o al detener el coach). No toca una grabación hecha a mano">
                        <TextBlock Text="Grabar cada partida sola" Foreground="#F0A050" />
                    </CheckBox>
                    <Button Content="Captura de diagnóstico" Command="{Binding DiagnosticCommand}" Margin="6,0,10,0" Visibility="{Binding IsOn, Source={x:Static app:DevMode.Instance}, Converter={StaticResource BoolToVisibility}}"
                            ToolTip="{Binding Diagnostic, Source={x:Static hotkeys:HotkeyTips.Instance}}" />
                    <TextBlock Text="{Binding DiagnosticStatus}" Foreground="#C9C1B6" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Visibility="{Binding IsOn, Source={x:Static app:DevMode.Instance}, Converter={StaticResource BoolToVisibility}}" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Lo que ve el coach: todo lo leído en la última captura, mientras el coach corre -->
        <Border x:Name="LivePanel" DockPanel.Dock="Bottom" Background="#1E1A16" BorderBrush="#5C5046" BorderThickness="0,1,0,0" Padding="12,8"
                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}">
            <DockPanel DataContext="{Binding Live}">
                <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding Events}" Width="260" Margin="16,0,0,0" ToolTip="Últimos eventos leídos del log"
                              Visibility="{Binding IsOn, Source={x:Static app:DevMode.Instance}, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Foreground="#C9C1B6" FontSize="11" FontFamily="Consolas" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Header, Source={x:Static app:DevMode.Instance}}" Foreground="#E8C26A" FontWeight="SemiBold" Margin="0,0,16,0" />
                        <TextBlock Foreground="#F4F2EE" Visibility="{Binding IsOn, Source={x:Static app:DevMode.Instance}, Converter={StaticResource BoolToVisibility}}"><Run Text="Reloj " Foreground="#A39A8F" /><Run Text="{Binding Clock, Mode=OneWay}" /><Run Text="   Edad " Foreground="#A39A8F" /><Run Text="{Binding Age, Mode=OneWay}" /><Run Text="   Aldeanos " Foreground="#A39A8F" /><Run Text="{Binding Villagers, Mode=OneWay}" /><Run Text="   Inactivos " Foreground="#A39A8F" /><Run Text="{Binding Idle, Mode=OneWay}" /><Run Text="   Población " Foreground="#A39A8F" /><Run Text="{Binding Population, Mode=OneWay}" /></TextBlock>
                    </StackPanel>
                    <!-- Lo leído: solo con el modo desarrollador -->
                    <StackPanel Visibility="{Binding IsOn, Source={x:Static app:DevMode.Instance}, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl Margin="0,6,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" HorizontalAlignment="Left" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ContentControl Content="{Binding Food}" ContentTemplate="{StaticResource LiveResourceTemplate}" />
                        <ContentControl Content="{Binding Wood}" ContentTemplate="{StaticResource LiveResourceTemplate}" />
                        <ContentControl Content="{Binding Gold}" ContentTemplate="{StaticResource LiveResourceTemplate}" />
                        <ContentControl Content="{Binding Stone}" ContentTemplate="{StaticResource LiveResourceTemplate}" />
                    </ItemsControl>
                    <TextBlock Text="{Binding FoodFloor}" Foreground="#E8C26A" FontSize="12" Margin="0,4,0,0"
                               Visibility="{Binding FoodFloor, Converter={StaticResource NotEmptyToVisibility}}" />
                    <TextBlock Text="{Binding Queue}" Foreground="#C9C1B6" FontSize="12" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding Game}" Foreground="#C9C1B6" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                               Visibility="{Binding Game, Converter={StaticResource NotEmptyToVisibility}}" />
                    </StackPanel>
                    <DockPanel Margin="0,6,0,0">
                        <!-- Lo mismo que los atajos de Atrás, Ya está y Saltear desde el juego, para cuando el coach no ve algo (o los atajos no llegan) -->
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
                            <ComboBox ItemsSource="{Binding DataContext.LaneChoices, ElementName=LivePanel}" SelectedItem="{Binding DataContext.SelectedLane, ElementName=LivePanel}"
                                      DisplayMemberPath="Name" Margin="0,0,4,0" Padding="4,1"
                                      ToolTip="Sobre qué línea actúan Ya está y Saltear (también los atajos)" />
                            <Button Content="◀ Atrás" Command="{Binding DataContext.BackCommand, ElementName=LivePanel}" Padding="8,1" Margin="0,0,4,0"
                                    ToolTip="{Binding Back, Source={x:Static hotkeys:HotkeyTips.Instance}}" />
                            <Button Content="Ya está ▶" Command="{Binding DataContext.AdvanceCommand, ElementName=LivePanel}" Padding="8,1" Margin="0,0,4,0"
                                    ToolTip="{Binding Advance, Source={x:Static hotkeys:HotkeyTips.Instance}}" />
                            <Button Content="Saltear" Command="{Binding DataContext.SkipCommand, ElementName=LivePanel}" Padding="8,1"
                                    ToolTip="{Binding Skip, Source={x:Static hotkeys:HotkeyTips.Instance}}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Step}" Foreground="#C9C1B6" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <StackPanel Visibility="{Binding IsOn, Source={x:Static app:DevMode.Instance}, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl ItemsSource="{Binding Lanes}" Margin="0,2,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Foreground="#C9C1B6" FontSize="12" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding Problems}" Foreground="#F08070" FontSize="12"
                               Visibility="{Binding Problems, Converter={StaticResource NotEmptyToVisibility}}" />
                    <TextBlock Text="{Binding Usage}" Foreground="#A39A8F" FontSize="11" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== Build order: tu cuenta de la web, cómo se elige y tu lista (parte 4) ===== -->
        <Border x:Name="BuildOrdersPanel" Background="{StaticResource Panel}" Padding="16,12">
            <DockPanel LastChildFill="False">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Conectar cuenta" Command="{Binding ConnectCommand}" Margin="0,0,6,0"
                                Visibility="{Binding Connected, Converter={StaticResource InverseBoolToVisibility}}"
                                ToolTip="Abre Mi cuenta en la web: ahí &quot;Conectar la app&quot; trae tu cuenta acá" />
                        <Button Content="Cuenta…" Command="{Binding AccountSettingsCommand}" Margin="0"
                                ToolTip="Dirección de la web y el token pegado a mano" />
                    </StackPanel>
                    <TextBlock Text="BUILD ORDER" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <TextBlock Text="{Binding AccountText}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <StackPanel x:Name="ModeBox" DockPanel.Dock="Top" Margin="0,0,0,8">
                    <RadioButton IsChecked="{Binding IsAutoMode}" Margin="0,0,0,4" GroupName="BoMode">
                        <TextBlock Text="Automática: la sugerida para tu civ, mapa y rival en cada partida" Foreground="{StaticResource Text}" />
                    </RadioButton>
                    <RadioButton IsChecked="{Binding IsManualMode}" GroupName="BoMode">
                        <TextBlock Text="Elegir de tu lista:" Foreground="{StaticResource Text}" />
                    </RadioButton>
                </StackPanel>
                <ListBox DockPanel.Dock="Top" ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}" BorderThickness="0" MaxHeight="420"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"
                         ToolTip="Con &quot;Elegir de tu lista&quot;, la que usa el coach (se baja al elegirla)">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type coaching:BuildOrderEntryViewModel}">
                            <Grid Margin="2,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="{Binding Detail}" Foreground="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="8,0" />
                                <TextBlock Grid.Column="2" Text="{Binding State}" Foreground="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <WrapPanel x:Name="BuildOrderButtons" DockPanel.Dock="Top" Margin="0,8,0,0">
                    <Button Content="Buscar más BO en la web" Command="{Binding SearchMoreCommand}" Margin="0,0,6,6"
                            ToolTip="La biblioteca de la web: &quot;Usar en el coach&quot; suma una BO a tu lista" />
                    <Button Content="Pegar código" Command="{Binding PasteCodeCommand}" Margin="0,0,6,6"
                            ToolTip="El código de 6 letras de una BO de la web (o el enlace de su página): se suma a tu lista" />
                    <Button Content="Actualizar lista" Command="{Binding RefreshCommand}" Margin="0,0,6,6" />
                </WrapPanel>
            </DockPanel>
        </Border>
    </DockPanel>
</Window>
