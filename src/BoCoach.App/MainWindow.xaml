<Window x:Class="BoCoach.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:editor="clr-namespace:BoCoach.App.Editor"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance editor:MainViewModel}"
        Title="AoE2 BO Coach · Editor de build orders"
        Width="1440" Height="880" MinWidth="1100" MinHeight="640"
        FontFamily="Segoe UI" FontSize="13"
        Background="{StaticResource Background}" Foreground="{StaticResource Text}">

    <Window.InputBindings>
        <KeyBinding Modifiers="Ctrl" Key="S" Command="{Binding SaveCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="N" Command="{Binding NewCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="D1" Command="{Binding Editor.AddVillagersCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="D2" Command="{Binding Editor.AddBuildCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="D3" Command="{Binding Editor.AddResearchCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="D4" Command="{Binding Editor.AddMoveCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="D" Command="{Binding Editor.DuplicateStepCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="Delete" Command="{Binding Editor.RemoveStepCommand}" />
        <KeyBinding Modifiers="Alt" Key="Up" Command="{Binding Editor.MoveUpCommand}" />
        <KeyBinding Modifiers="Alt" Key="Down" Command="{Binding Editor.MoveDownCommand}" />
    </Window.InputBindings>

    <DockPanel>
        <!-- Barra de estado -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="12,5">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Foreground="{StaticResource Muted}" Text="{Binding LibraryPath, StringFormat=Biblioteca: {0}}" />
                <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <!-- Herramientas de captura: calibrar la pantalla y grabar partidas -->
        <Border x:Name="ToolsBar" DockPanel.Dock="Top" Background="#2B2622" Padding="12,7">
            <DockPanel>
                <TextBlock Text="AoE2 BO Coach" Foreground="#F4F2EE" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" Margin="0,0,18,0" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <StackPanel x:Name="MaxVillagersBox" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0"
                                ToolTip="Hasta cuántos aldeanos producen sin parar los centros urbanos (100 a 130 según la estrategia). La comida nunca baja de lo que necesitan. Se aplica al empezar el coach">
                        <TextBlock Text="Máx. aldeanos" Foreground="#A39A8F" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding MaxVillagers, UpdateSourceTrigger=LostFocus}" Width="44" VerticalContentAlignment="Center"
                                 AutomationProperties.Name="Máximo de aldeanos" />
                    </StackPanel>
                    <Button x:Name="CoachButton" Content="{Binding ButtonText}" Command="{Binding StartStopCommand}" FontWeight="SemiBold"
                            ToolTip="Sigue la BO elegida en la biblioteca con el overlay sobre el juego. También con Ctrl+Alt+S desde el juego" />
                    <Button Content="Calibrar pantalla…" Command="{Binding CalibrateCommand}" ToolTip="También con Ctrl+Alt+C desde el juego" />
                    <Button Content="{Binding RecordButtonText}" Command="{Binding ToggleRecordingCommand}" ToolTip="También con Ctrl+Alt+R desde el juego" />
                    <Button Content="Grabaciones" Command="{Binding OpenRecordingsCommand}" Margin="0" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Foreground="#C9C1B6" FontSize="12"><Run Text="{Binding CalibrationStatus, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding GameStatus, Mode=OneWay}" /></TextBlock>
                    <TextBlock Text="{Binding RecordingStatus}" FontSize="12" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding RecordingStatus, Converter={StaticResource NotEmptyToVisibility}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#8CD17D" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                        <Setter Property="Foreground" Value="#F08070" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Lo que ve el coach: todo lo leído en la última captura, mientras el coach corre -->
        <Border x:Name="LivePanel" DockPanel.Dock="Top" Background="#1E1A16" BorderBrush="#5C5046" BorderThickness="0,0,0,1" Padding="12,8"
                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}">
            <DockPanel DataContext="{Binding Live}">
                <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding Events}" Width="260" Margin="16,0,0,0" ToolTip="Últimos eventos leídos del log">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Foreground="#C9C1B6" FontSize="11" FontFamily="Consolas" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Lo que ve el coach" Foreground="#E8C26A" FontWeight="SemiBold" Margin="0,0,16,0" />
                        <TextBlock Foreground="#F4F2EE"><Run Text="Reloj " Foreground="#A39A8F" /><Run Text="{Binding Clock, Mode=OneWay}" /><Run Text="   Edad " Foreground="#A39A8F" /><Run Text="{Binding Age, Mode=OneWay}" /><Run Text="   Aldeanos " Foreground="#A39A8F" /><Run Text="{Binding Villagers, Mode=OneWay}" /><Run Text="   Inactivos " Foreground="#A39A8F" /><Run Text="{Binding Idle, Mode=OneWay}" /><Run Text="   Población " Foreground="#A39A8F" /><Run Text="{Binding Population, Mode=OneWay}" /></TextBlock>
                    </StackPanel>
                    <ItemsControl Margin="0,6,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" HorizontalAlignment="Left" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ContentControl Content="{Binding Food}" ContentTemplate="{StaticResource LiveResourceTemplate}" />
                        <ContentControl Content="{Binding Wood}" ContentTemplate="{StaticResource LiveResourceTemplate}" />
                        <ContentControl Content="{Binding Gold}" ContentTemplate="{StaticResource LiveResourceTemplate}" />
                        <ContentControl Content="{Binding Stone}" ContentTemplate="{StaticResource LiveResourceTemplate}" />
                    </ItemsControl>
                    <TextBlock Text="{Binding FoodFloor}" Foreground="#E8C26A" FontSize="12" Margin="0,4,0,0"
                               Visibility="{Binding FoodFloor, Converter={StaticResource NotEmptyToVisibility}}" />
                    <TextBlock Text="{Binding Step}" Foreground="#C9C1B6" FontSize="12" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Problems}" Foreground="#F08070" FontSize="12"
                               Visibility="{Binding Problems, Converter={StaticResource NotEmptyToVisibility}}" />
                    <TextBlock Text="{Binding Usage}" Foreground="#A39A8F" FontSize="11" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="430" />
            </Grid.ColumnDefinitions>

            <!-- ===== Biblioteca ===== -->
            <Border Grid.Column="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="BIBLIOTECA" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                    <TextBox DockPanel.Dock="Top" x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Buscar por nombre, civ, tags o descripción" Margin="0,0,0,8" />
                    <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <Button Content="Nueva" Command="{Binding NewCommand}" ToolTip="Ctrl+N" Margin="0,0,6,6" />
                        <Button Content="Importar…" Command="{Binding ImportCommand}" Margin="0,0,6,6" />
                        <Button Content="Desde la web…" Command="{Binding ImportFromWebCommand}" Margin="0,0,6,6"
                                ToolTip="Importar una BO de la biblioteca web con su código" />
                        <Button Content="A la papelera" Command="{Binding TrashCommand}" Margin="0,0,6,6" />
                        <Button Content="Cuenta de la web…" Command="{Binding WebAccountSettingsCommand}" Margin="0,0,6,6"
                                ToolTip="Dirección de la web, token para publicar y enlaces bocoach://" />
                    </WrapPanel>
                    <ListBox ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2,4">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Foreground="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis"
                                               Text="{Binding BuildOrder.Civ, StringFormat=Civ: {0}}" />
                                    <TextBlock Foreground="{StaticResource Danger}" FontSize="11" TextWrapping="Wrap"
                                               Text="{Binding Error}" Visibility="{Binding Error, Converter={StaticResource NotEmptyToVisibility}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- ===== Sin BO abierta ===== -->
            <TextBlock Grid.Column="1" Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{StaticResource Muted}" FontSize="15" TextAlignment="Center"
                       Visibility="{Binding Editor, Converter={StaticResource NullToVisibility}}"
                       Text="Elegí una build order de la biblioteca o creá una nueva con Ctrl+N." />

            <!-- ===== Editor: encabezado y pasos ===== -->
            <DockPanel Grid.Column="1" Margin="16,12,16,12" DataContext="{Binding Editor}"
                       Visibility="{Binding Converter={StaticResource NotEmptyToVisibility}}">
                <StackPanel DockPanel.Dock="Top">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="● sin guardar" Foreground="{StaticResource Warning}" VerticalAlignment="Center" Margin="0,0,10,0"
                                       Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}}" />
                            <Button Content="Guardar" Style="{StaticResource PrimaryButton}" ToolTip="Ctrl+S"
                                    Command="{Binding DataContext.SaveCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <Button Content="Duplicar BO" Command="{Binding DataContext.DuplicateCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <Button Content="Exportar…" Command="{Binding DataContext.ExportCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <Button Content="Publicar en la web" Margin="0" Command="{Binding DataContext.PublishToWebCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    ToolTip="Publica (o reemplaza) esta BO en la biblioteca web con tu cuenta" />
                        </StackPanel>
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" FontSize="20" FontWeight="SemiBold"
                                 BorderThickness="0,0,0,1" Background="Transparent" Margin="0,0,16,0" ToolTip="Nombre de la build order" />
                    </DockPanel>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Civ" Style="{StaticResource FieldLabel}" />
                        <ComboBox Grid.Column="1" IsEditable="True" ItemsSource="{Binding CivOptions}"
                                  Text="{Binding Civ, UpdateSourceTrigger=PropertyChanged}"
                                  ToolTip="'any' o la civ: la vista previa usa sus bonificaciones (recolección, costos, arranque)" />
                        <TextBlock Grid.Column="2" Text="Autor" Style="{StaticResource FieldLabel}" Margin="14,0,8,0" />
                        <TextBox Grid.Column="3" Text="{Binding Author, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Column="4" Text="Tags" Style="{StaticResource FieldLabel}" Margin="14,0,8,0" />
                        <TextBox Grid.Column="5" Text="{Binding TagsText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Separados por coma" />
                    </Grid>
                    <TextBox Margin="0,8,0,0" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap"
                             AcceptsReturn="True" MinHeight="44" MaxHeight="80" VerticalScrollBarVisibility="Auto" ToolTip="Descripción" />

                    <!-- Barra de pasos -->
                    <WrapPanel Margin="0,14,0,8">
                        <Button Content="+ Aldeanos" Style="{StaticResource AddButton}" Command="{Binding AddVillagersCommand}" ToolTip="Ctrl+1" />
                        <Button Content="+ Construir" Style="{StaticResource AddButton}" Command="{Binding AddBuildCommand}" ToolTip="Ctrl+2" />
                        <Button Content="+ Investigar" Style="{StaticResource AddButton}" Command="{Binding AddResearchCommand}" ToolTip="Ctrl+3" />
                        <Button Content="+ Mover" Style="{StaticResource AddButton}" Command="{Binding AddMoveCommand}" ToolTip="Ctrl+4" Margin="0,0,18,0" />
                        <Button Content="Duplicar" Command="{Binding DuplicateStepCommand}" ToolTip="Ctrl+D" />
                        <Button Content="▲" Command="{Binding MoveUpCommand}" ToolTip="Subir (Alt+↑)" />
                        <Button Content="▼" Command="{Binding MoveDownCommand}" ToolTip="Bajar (Alt+↓)" />
                        <Button Content="Quitar" Command="{Binding RemoveStepCommand}" ToolTip="Ctrl+Supr" />
                    </WrapPanel>
                </StackPanel>

                <!-- Lista de pasos con su tiempo estimado -->
                <ListBox x:Name="StepList" ItemsSource="{Binding Steps}" SelectedItem="{Binding SelectedStep}"
                         AllowDrop="True" Drop="StepList_Drop" DragOver="StepList_DragOver"
                         HorizontalContentAlignment="Stretch" BorderBrush="{StaticResource Border}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="editor:StepViewModel">
                            <Grid Margin="0,3" ToolTip="{Binding IssueText}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="120" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="⋮⋮" Foreground="{StaticResource Muted}" Cursor="SizeAll" VerticalAlignment="Center"
                                           ToolTip="Arrastrá para reordenar" MouseMove="DragHandle_MouseMove" />
                                <TextBlock Grid.Column="1" Text="{Binding Number}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="✖ " Foreground="{StaticResource Danger}" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Text="⚠ " Foreground="{StaticResource Warning}" Visibility="{Binding HasWarning, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Text="{Binding Description}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding BlockText}" FontSize="11" Foreground="{StaticResource Danger}"
                                               Visibility="{Binding IsPopBlocked, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                                <!-- Mini línea de tiempo: dónde cae el paso dentro de toda la BO -->
                                <Border Grid.Column="3" Height="10" Background="#EEEAE3" CornerRadius="2" Margin="8,0" VerticalAlignment="Center"
                                        ToolTip="{Binding BlockText}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{Binding BarStart, Converter={StaticResource Star}}" />
                                            <ColumnDefinition Width="{Binding BarWidth, Converter={StaticResource Star}}" />
                                            <ColumnDefinition Width="{Binding BarRest, Converter={StaticResource Star}}" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="1" CornerRadius="2">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource Bar}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPopBlocked}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource Danger}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                    </Grid>
                                </Border>
                                <TextBlock Grid.Column="4" Text="{Binding EstimateText}" Foreground="{StaticResource Muted}"
                                           VerticalAlignment="Center" FontFamily="Consolas" FontSize="12" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- ===== Panel derecho: paso, objetivos, vista previa y problemas ===== -->
            <Border Grid.Column="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1,0,0,0"
                    DataContext="{Binding Editor}" Visibility="{Binding Converter={StaticResource NotEmptyToVisibility}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,4,16,16">
                    <StackPanel>
                        <!-- Paso seleccionado -->
                        <TextBlock Text="PASO SELECCIONADO" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Elegí un paso de la lista." Foreground="{StaticResource Muted}"
                                   Visibility="{Binding SelectedStep, Converter={StaticResource NullToVisibility}}" />
                        <Grid DataContext="{Binding SelectedStep}" Visibility="{Binding Converter={StaticResource NotEmptyToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.Resources>
                                <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                    <Setter Property="Margin" Value="0,3" />
                                </Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                    <Setter Property="Margin" Value="0,3" />
                                </Style>
                            </Grid.Resources>

                            <TextBlock Grid.Row="0" Text="Acción" Style="{StaticResource FieldLabel}" />
                            <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{x:Static editor:Options.Actions}"
                                      SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding Action}" />

                            <TextBlock Grid.Row="1" Text="Qué" Style="{StaticResource FieldLabel}"
                                       Visibility="{Binding UsesEntity, Converter={StaticResource BoolToVisibility}}" />
                            <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding EntityOptions}" IsTextSearchEnabled="True" TextSearch.TextPath="Label"
                                      SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding What}"
                                      Visibility="{Binding UsesEntity, Converter={StaticResource BoolToVisibility}}" />

                            <TextBlock Grid.Row="2" Text="Cantidad" Style="{StaticResource FieldLabel}" ToolTip="En los pasos de aldeanos: cuántos tiene que haber en el recurso al terminar el paso, contando los que ya están (como el contador del HUD)." />
                            <TextBox Grid.Row="2" Grid.Column="1" Width="70" HorizontalAlignment="Left"
                                     Text="{Binding Count, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="3" Text="Desde" Style="{StaticResource FieldLabel}"
                                       Visibility="{Binding UsesFrom, Converter={StaticResource BoolToVisibility}}" />
                            <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{x:Static editor:Options.Sources}"
                                      SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding From}"
                                      ToolTip="De dónde salen los aldeanos (en 'construir': vacío = aldeanos sin tarea)"
                                      Visibility="{Binding UsesFrom, Converter={StaticResource BoolToVisibility}}" />

                            <TextBlock Grid.Row="4" Text="Asignar a" Style="{StaticResource FieldLabel}"
                                       Visibility="{Binding UsesAssign, Converter={StaticResource BoolToVisibility}}" />
                            <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{x:Static editor:Options.Sources}"
                                      SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding Assign}"
                                      ToolTip="A dónde van los aldeanos nuevos, los constructores al terminar o los que se mueven"
                                      Visibility="{Binding UsesAssign, Converter={StaticResource BoolToVisibility}}" />

                            <TextBlock Grid.Row="5" Text="Constructores" Style="{StaticResource FieldLabel}"
                                       Visibility="{Binding IsBuild, Converter={StaticResource BoolToVisibility}}" />
                            <TextBox Grid.Row="5" Grid.Column="1" Width="70" HorizontalAlignment="Left"
                                     Text="{Binding Builders, TargetNullValue='', UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Vacío = 1 (en granjas, uno por granja)"
                                     Visibility="{Binding IsBuild, Converter={StaticResource BoolToVisibility}}" />

                            <TextBlock Grid.Row="6" Text="Después de" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding AfterText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Ids de pasos que tienen que estar terminados, separados por coma (ej.: s4, s13)" />

                            <TextBlock Grid.Row="7" Text="A población" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Row="7" Grid.Column="1" Width="70" HorizontalAlignment="Left"
                                     Text="{Binding AtPop, TargetNullValue='', UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="8" Text="A tiempo" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Row="8" Grid.Column="1" Width="70" HorizontalAlignment="Left"
                                     Text="{Binding AtTimeText, UpdateSourceTrigger=PropertyChanged}" ToolTip="mm:ss" />

                            <TextBlock Grid.Row="9" Text="Confirmar con" Style="{StaticResource FieldLabel}" />
                            <ComboBox Grid.Row="9" Grid.Column="1" ItemsSource="{Binding ConfirmOptions}"
                                      SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding ConfirmBy}"
                                      ToolTip="Evento del log que confirma el paso" />

                            <TextBlock Grid.Row="10" Text="Nota" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" Margin="0,6,8,0" />
                            <TextBox Grid.Row="10" Grid.Column="1" Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"
                                     TextWrapping="Wrap" AcceptsReturn="True" MinHeight="40" />

                            <TextBlock Grid.Row="11" Text="Id" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Row="11" Grid.Column="1" Width="70" HorizontalAlignment="Left"
                                     Text="{Binding Id, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="12" Grid.ColumnSpan="2" Text="{Binding IssueText}" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Foreground="{StaticResource Danger}" Visibility="{Binding IssueText, Converter={StaticResource NotEmptyToVisibility}}" />
                        </Grid>

                        <!-- Objetivos -->
                        <TextBlock Text="OBJETIVOS" Style="{StaticResource SectionTitle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="70" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Click Feudal" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Column="1" Text="{Binding FeudalTargetText, UpdateSourceTrigger=PropertyChanged}" ToolTip="mm:ss" />
                            <TextBlock Grid.Column="2" Text="Castillos" Style="{StaticResource FieldLabel}" Margin="14,0,8,0" />
                            <TextBox Grid.Column="3" Text="{Binding CastleTargetText, UpdateSourceTrigger=PropertyChanged}" ToolTip="mm:ss" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="Aldeanos en Feudal" Style="{StaticResource FieldLabel}" Width="122" />
                            <TextBlock Text="C" Style="{StaticResource FieldLabel}" Margin="0,0,4,0" ToolTip="Comida" />
                            <TextBox Width="36" Text="{Binding FeudalFood, TargetNullValue='', UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="M" Style="{StaticResource FieldLabel}" Margin="8,0,4,0" ToolTip="Madera" />
                            <TextBox Width="36" Text="{Binding FeudalWood, TargetNullValue='', UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="O" Style="{StaticResource FieldLabel}" Margin="8,0,4,0" ToolTip="Oro" />
                            <TextBox Width="36" Text="{Binding FeudalGold, TargetNullValue='', UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="P" Style="{StaticResource FieldLabel}" Margin="8,0,4,0" ToolTip="Piedra" />
                            <TextBox Width="36" Text="{Binding FeudalStone, TargetNullValue='', UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <!-- Vista previa -->
                        <TextBlock Text="VISTA PREVIA" Style="{StaticResource SectionTitle}" />
                        <ItemsControl ItemsSource="{Binding Summary}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Problemas -->
                        <TextBlock Text="PROBLEMAS" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Ninguno." Foreground="{StaticResource Muted}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Problems.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding Problems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2" Foreground="{StaticResource Danger}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>
