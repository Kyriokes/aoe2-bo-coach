<Window x:Class="BoCoach.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hotkeys="clr-namespace:BoCoach.App.Hotkeys"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:coaching="clr-namespace:BoCoach.App.Coaching"
        xmlns:app="clr-namespace:BoCoach.App"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance coaching:HomeViewModel}"
        Title="{x:Static app:AppVersion.WindowTitle}"
        Width="1100" Height="760" MinWidth="900" MinHeight="600"
        Style="{StaticResource AppWindow}">

    <Window.Resources>
        <!-- Una de las cuatro tarjetas: un círculo con el estado, el título, lo que sabe y sus enlaces -->
        <DataTemplate x:Key="StepCard" DataType="{x:Type coaching:HomeStep}">
            <Border x:Name="Card" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="22" Height="22" Margin="0,0,8,0">
                            <Ellipse x:Name="Dot" Fill="{StaticResource BorderSoft}" />
                            <TextBlock x:Name="Glyph" Text="·" Foreground="{StaticResource AccentInk}" FontWeight="Bold" FontSize="12"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Grid.Row="1" Text="{Binding Detail}" ToolTip="{Binding Detail}" Style="{StaticResource Hint}" Foreground="{StaticResource TextSoft}"
                               Margin="0,8,0,0" MaxHeight="36" TextTrimming="CharacterEllipsis" />
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,6,0,0"
                                Visibility="{Binding Link, Converter={StaticResource NotEmptyToVisibility}}">
                        <Button Content="{Binding Link.Label}" Style="{StaticResource LinkButton}"
                                Command="{Binding DataContext.RunCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Link.Action}" />
                        <Button Content="{Binding SecondLink.Label}" Style="{StaticResource LinkButton}" Margin="14,0,0,0"
                                Command="{Binding DataContext.RunCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding SecondLink.Action}"
                                Visibility="{Binding SecondLink, Converter={StaticResource NotEmptyToVisibility}}" />
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Done">
                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Good}" />
                    <Setter TargetName="Glyph" Property="Text" Value="✓" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Current">
                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Accent}" />
                    <Setter TargetName="Glyph" Property="Text" Value="▶" />
                    <Setter TargetName="Glyph" Property="FontSize" Value="10" />
                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Accent}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Warning">
                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Danger}" />
                    <Setter TargetName="Glyph" Property="Text" Value="!" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Info">
                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource TextSoft}" />
                    <Setter TargetName="Glyph" Property="Text" Value="↗" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Todo">
                    <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource Muted}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- Barra de estado: el último mensaje y, si se está grabando, la grabación -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Field}" BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,1,0,0" Padding="16,5">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding Tools.RecordingStatus}" FontSize="12" Margin="16,0,0,0" MaxWidth="460" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Tools.RecordingStatus}" Visibility="{Binding Tools.RecordingStatus, Converter={StaticResource NotEmptyToVisibility}}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource Good}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Tools.IsRecording}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource Danger}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding BuildOrders.Status}" ToolTip="{Binding BuildOrders.Status}" Foreground="{StaticResource TextSoft}" FontSize="12" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <!-- En la partida: corregir lo que el coach no vio; con el modo desarrollador, todo lo leído en la última captura -->
        <Border x:Name="LivePanel" DockPanel.Dock="Bottom" Background="{StaticResource Panel}" BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,1,0,0" Padding="16,10"
                Visibility="{Binding ShowLive, Converter={StaticResource BoolToVisibility}}">
            <DockPanel DataContext="{Binding Coach.Live}">
                <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding Events}" Width="260" Margin="16,0,0,0" ToolTip="{x:Static app:Texts.LogTip}"
                              Visibility="{Binding IsOn, Source={x:Static app:DevMode.Instance}, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Foreground="{StaticResource TextSoft}" FontSize="11" FontFamily="Consolas" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel>
                    <DockPanel>
                        <!-- Lo mismo que los atajos de Atrás y Saltear desde el juego; "Ya está" va en el cuadro de estado -->
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
                            <TextBlock Text="{x:Static app:Texts.LaneLabel}" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding DataContext.Coach.LaneChoices, ElementName=LivePanel}" SelectedItem="{Binding DataContext.Coach.SelectedLane, ElementName=LivePanel}"
                                      DisplayMemberPath="Name" Margin="0,0,6,0" MinWidth="150"
                                      ToolTip="{x:Static app:Texts.LaneTip}" />
                            <Button Content="{x:Static app:Texts.Back}" Command="{Binding DataContext.Coach.BackCommand, ElementName=LivePanel}"
                                    ToolTip="{Binding Back, Source={x:Static hotkeys:HotkeyTips.Instance}}" />
                            <Button Content="{x:Static app:Texts.Skip}" Command="{Binding DataContext.Coach.SkipCommand, ElementName=LivePanel}" Margin="0"
                                    ToolTip="{Binding Skip, Source={x:Static hotkeys:HotkeyTips.Instance}}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Header, Source={x:Static app:DevMode.Instance}}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0,0,14,0" />
                        <TextBlock Text="{Binding Step}" ToolTip="{Binding Step}" Foreground="{StaticResource TextSoft}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <!-- Lo leído: solo con el modo desarrollador -->
                    <StackPanel Visibility="{Binding IsOn, Source={x:Static app:DevMode.Instance}, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Margin="0,8,0,0"><Run Text="{x:Static app:Texts.LiveClock}" Foreground="{StaticResource Muted}" /><Run Text="{Binding Clock, Mode=OneWay}" /><Run Text="{x:Static app:Texts.LiveAge}" Foreground="{StaticResource Muted}" /><Run Text="{Binding Age, Mode=OneWay}" /><Run Text="{x:Static app:Texts.LiveVillagers}" Foreground="{StaticResource Muted}" /><Run Text="{Binding Villagers, Mode=OneWay}" /><Run Text="{x:Static app:Texts.LiveIdle}" Foreground="{StaticResource Muted}" /><Run Text="{Binding Idle, Mode=OneWay}" /><Run Text="{x:Static app:Texts.LivePopulation}" Foreground="{StaticResource Muted}" /><Run Text="{Binding Population, Mode=OneWay}" /></TextBlock>
                        <ItemsControl Margin="0,6,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" HorizontalAlignment="Left" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ContentControl Content="{Binding Food}" ContentTemplate="{StaticResource LiveResourceTemplate}" />
                            <ContentControl Content="{Binding Wood}" ContentTemplate="{StaticResource LiveResourceTemplate}" />
                            <ContentControl Content="{Binding Gold}" ContentTemplate="{StaticResource LiveResourceTemplate}" />
                            <ContentControl Content="{Binding Stone}" ContentTemplate="{StaticResource LiveResourceTemplate}" />
                        </ItemsControl>
                        <TextBlock Text="{Binding FoodFloor}" Foreground="{StaticResource Accent}" FontSize="12" Margin="0,4,0,0"
                                   Visibility="{Binding FoodFloor, Converter={StaticResource NotEmptyToVisibility}}" />
                        <TextBlock Text="{Binding Queue}" Foreground="{StaticResource TextSoft}" FontSize="12" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding Game}" Foreground="{StaticResource TextSoft}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding Game, Converter={StaticResource NotEmptyToVisibility}}" />
                        <ItemsControl ItemsSource="{Binding Lanes}" Margin="0,4,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="{StaticResource TextSoft}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding Problems}" Foreground="{StaticResource Danger}" FontSize="12"
                                   Visibility="{Binding Problems, Converter={StaticResource NotEmptyToVisibility}}" />
                        <TextBlock Text="{Binding Usage}" Foreground="{StaticResource Muted}" FontSize="11" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Margin="20,14,20,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="150" />
            </Grid.RowDefinitions>

            <!-- Cabecera -->
            <DockPanel Margin="0,0,0,12">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="{Binding Tools.RecordButtonText}" Command="{Binding Tools.ToggleRecordingCommand}"
                            Visibility="{Binding Tools.RecordButtonVisible, Converter={StaticResource BoolToVisibility}}"
                            ToolTip="{Binding Record, Source={x:Static hotkeys:HotkeyTips.Instance}}" />
                    <Button Content="{x:Static app:Texts.SupportButton}" Click="Support_Click" ToolTip="{x:Static app:Texts.SupportTip}" />
                    <Button Content="{x:Static app:Texts.HotkeysButton}" Click="Hotkeys_Click" ToolTip="{x:Static app:Texts.HotkeysTip}" />
                    <Button Content="{x:Static app:Texts.SettingsButton}" Click="Settings_Click" ToolTip="{x:Static app:Texts.SettingsTip}" Margin="0" />
                </StackPanel>
                <TextBlock Text="{x:Static app:Texts.AppName}" Style="{StaticResource AppTitle}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <!-- 5 clics prenden el modo desarrollador -->
                <TextBlock Text="{x:Static app:AppVersion.Text}" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" Background="Transparent"
                           MouseLeftButtonUp="Version_Click" ToolTip="{x:Static app:Texts.VersionTip}" />
            </DockPanel>

            <!-- El cuadro de estado: qué está pasando y qué hacer -->
            <Border Grid.Row="1" Background="{StaticResource PanelRaised}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,12" MinHeight="96">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="StateBar" CornerRadius="7,0,0,7">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource Accent}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Screen.State}" Value="NoAccount">
                                        <Setter Property="Background" Value="{StaticResource Danger}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Screen.State}" Value="InGame">
                                        <Setter Property="Background" Value="{StaticResource Good}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Screen.State}" Value="Finished">
                                        <Setter Property="Background" Value="{StaticResource Info}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="18,12">
                        <TextBlock Text="{Binding Screen.Title}" FontSize="24" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource Accent}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Screen.State}" Value="NoAccount">
                                            <Setter Property="Foreground" Value="{StaticResource Danger}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Screen.State}" Value="InGame">
                                            <Setter Property="Foreground" Value="{StaticResource Good}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Screen.State}" Value="Finished">
                                            <Setter Property="Foreground" Value="{StaticResource Info}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding Screen.Detail}" ToolTip="{Binding Screen.Detail}" Style="{StaticResource Body}" Margin="0,4,0,0" MaxHeight="38" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
                        <Button x:Name="PrimaryAction" Style="{StaticResource PrimaryButton}" Padding="18,9" FontSize="14"
                                Content="{Binding Screen.Primary.Label}" Command="{Binding RunCommand}" CommandParameter="{Binding Screen.Primary.Action}"
                                ToolTip="{Binding PrimaryTip}" Visibility="{Binding Screen.Primary, Converter={StaticResource NotEmptyToVisibility}}" />
                        <Button x:Name="SecondaryAction" Padding="14,9" Margin="0"
                                Content="{Binding Screen.Secondary.Label}" Command="{Binding RunCommand}" CommandParameter="{Binding Screen.Secondary.Action}"
                                ToolTip="{Binding SecondaryTip}" Visibility="{Binding Screen.Secondary, Converter={StaticResource NotEmptyToVisibility}}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Los cuatro pasos -->
            <Grid Grid.Row="2" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ContentControl Grid.Column="0" Content="{Binding Screen.Account}" ContentTemplate="{StaticResource StepCard}" Focusable="False" />
                <ContentControl Grid.Column="2" Content="{Binding Screen.BuildOrder}" ContentTemplate="{StaticResource StepCard}" Focusable="False" />
                <ContentControl Grid.Column="4" Content="{Binding Screen.Play}" ContentTemplate="{StaticResource StepCard}" Focusable="False" />
                <ContentControl Grid.Column="6" Content="{Binding Screen.Report}" ContentTemplate="{StaticResource StepCard}" Focusable="False" />
            </Grid>

            <!-- Build order: cómo se elige y tu lista -->
            <DockPanel Grid.Row="3">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <StackPanel x:Name="BuildOrderButtons" DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="{x:Static app:Texts.SearchMore}" Command="{Binding BuildOrders.SearchMoreCommand}" ToolTip="{x:Static app:Texts.SearchMoreTip}" />
                        <Button Content="{x:Static app:Texts.PasteCode}" Command="{Binding BuildOrders.PasteCodeCommand}" ToolTip="{x:Static app:Texts.PasteCodeTip}" />
                        <Button Content="{x:Static app:Texts.RefreshList}" Command="{Binding BuildOrders.RefreshCommand}" Margin="0" />
                    </StackPanel>
                    <TextBlock Text="{x:Static app:Texts.BuildOrderSection}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                </DockPanel>
                <StackPanel x:Name="ModeBox" DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <RadioButton IsChecked="{Binding Coach.IsAutoMode}" GroupName="BoMode" Content="{x:Static app:Texts.ModeAuto}" Margin="0,0,28,0" />
                    <RadioButton IsChecked="{Binding Coach.IsManualMode}" GroupName="BoMode" Content="{x:Static app:Texts.ModeManual}" />
                </StackPanel>
                <Grid>
                    <TextBlock Text="{Binding BuildOrders.EmptyListText}" Style="{StaticResource Hint}" Margin="2,8,0,0"
                               Visibility="{Binding BuildOrders.HasEntries, Converter={StaticResource InverseBoolToVisibility}}" />
                    <ListBox x:Name="BuildOrderList" ItemsSource="{Binding BuildOrders.Entries}" SelectedItem="{Binding BuildOrders.SelectedEntry}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ToolTip="{x:Static app:Texts.ListTip}" AutomationProperties.Name="{x:Static app:Texts.BuildOrderSection}">
                        <ListBox.Style>
                            <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                                <Style.Triggers>
                                    <!-- En automática la lista no manda: se ve más apagada, y tocar una pasa a "Elegir" -->
                                    <DataTrigger Binding="{Binding Coach.IsAutoMode}" Value="True">
                                        <Setter Property="Opacity" Value="0.8" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.Style>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <EventSetter Event="PreviewMouseLeftButtonDown" Handler="Entry_Click" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type coaching:BuildOrderEntryViewModel}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="5*" />
                                        <ColumnDefinition Width="4*" />
                                        <ColumnDefinition Width="Auto" MinWidth="110" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{Binding Detail}" Foreground="{StaticResource TextSoft}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="10,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding State}" Foreground="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
