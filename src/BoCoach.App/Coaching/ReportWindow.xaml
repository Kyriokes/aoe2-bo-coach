<Window x:Class="BoCoach.App.Coaching.ReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:BoCoach.App"
        Title="{x:Static app:Texts.ReportTitle}" Width="620" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Style="{StaticResource AppWindow}">
    <StackPanel Margin="20">
        <TextBlock x:Name="Heading" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Accent}" TextWrapping="Wrap" Margin="0,0,0,12" />
        <Border Style="{StaticResource Card}">
            <ScrollViewer x:Name="LinesScroll" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="Lines">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Style="{StaticResource Body}" Margin="0,3" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="{x:Static app:Texts.ReportOpenFull}" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Open_Click" />
            <Button Content="{x:Static app:Texts.Close}" IsCancel="True" Margin="0" Click="Close_Click" />
        </StackPanel>
    </StackPanel>
</Window>
