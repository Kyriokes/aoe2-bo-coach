<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BoCoach.Core\BoCoach.Core.csproj" />
  </ItemGroup>

  <!-- Datos reales del repo, copiados junto a los tests -->
  <ItemGroup>
    <None Include="..\..\data\game_data\*.json" Link="game_data\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\data\events*.json" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\data\civ_styles.json" Link="civ_styles.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\data\maps.json" Link="maps.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\build_orders\*.json" Link="build_orders\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- Las BO de ejemplo viejas (scouts y fast castle a mano): muchos tests dependen de sus pasos. -->
    <None Include="..\fixtures\build_orders\*.json" Link="build_orders\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\fixtures\rts-overlay\*.json" Link="fixtures\rts-overlay\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\fixtures\buildorderguide\*.json" Link="fixtures\buildorderguide\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\build_orders\civs\*.json" Link="civs\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- Lecturas reales (ya suavizadas) de la partida de scouts grabada, para correr el coach sin OCR -->
    <None Include="..\fixtures\rec-20261015-214512\lecturas.csv" Link="fixtures\scouts-20261015-214512.csv" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>